{
  "name": "konva-site-2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build && node scripts/generate-llms.js",
    "build:core": "docusaurus build --locale en && node scripts/generate-llms.js --locale en",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "check:i18n-drift": "node scripts/check-i18n-drift.js",
    "check:code-drift": "node scripts/check-code-drift.js",
    "check:fences": "node scripts/check-fences.js",
    "check:gallery": "node scripts/check-demo-gallery.js",
    "check:sandpack": "node scripts/check-sandpack-dependencies.js",
    "check:react-drag": "node scripts/check-react-drag-state.js",
    "check:performance": "node scripts/check-performance.js",
    "check:i18n": "node scripts/check-i18n.js",
    "panel:run": "node scripts/llm-panel/run.js",
    "panel:compare": "node scripts/llm-panel/compare.js",
    "update:i18n-sources": "node scripts/check-i18n-drift.js --write && node scripts/check-code-drift.js --write",
    "check": "npm run check:fences && npm run check:gallery && npm run check:sandpack && npm run check:react-drag && npm run typecheck && npm run build:core && npm run check:performance && node checksitemap.js build/sitemap.xml && npm run check:llms",
    "check:llms": "node scripts/check-llms.js"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@docusaurus/core": "3.9.1",
    "@docusaurus/preset-classic": "3.9.1",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "disqus-react": "^1.1.7",
    "jsdoc-api": "^9.3.4",
    "konva": "^10.5.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.1",
    "@docusaurus/tsconfig": "3.9.1",
    "@docusaurus/types": "3.9.1",
    "typescript": "~5.9.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
